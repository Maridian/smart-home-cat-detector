# ============================================================
# .env.example - DOCUMENTATION of expected secrets
#
# This file is committed only as a reference. It contains NO
# real values. On the Raspberry Pi / CI the real secrets are
# written to .env (which is gitignored and never committed).
#
# To create .env locally:
#   cp .env.example .env   # then fill in real values
# ============================================================

# RTSP camera stream (contains credentials -> SECRET)
RTSP_URL=rtsp://user:password@192.168.1.100:554/stream

# Telegram bot token from @BotFather -> SECRET
# (optional: leave empty to disable Telegram notifications)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID to receive notifications -> SECRET
# (optional: leave empty to disable Telegram notifications)
TELEGRAM_CHAT_ID=
