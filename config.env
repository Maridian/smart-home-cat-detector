# ============================================================
# Runtime configuration (COMMITTED - no secrets here!)
#
# This file contains only non-sensitive runtime parameters and
# is versioned in Git. Deployments pick it up automatically.
#
# Real secrets (RTSP credentials, Telegram tokens, webhooks)
# belong in .env which is gitignored and never committed.
# ============================================================

# Detection confidence threshold (0.0 - 1.0)
DETECTION_CONFIDENCE=0.5

# Path where detection images are stored (persistent host folder, mounted into the container)
IMAGE_SAVE_PATH=/home/admin123/cat_detections

# Cooldown between Telegram notifications (seconds)
NOTIFICATION_COOLDOWN=3600

# Heartbeat interval in seconds
HEARTBEAT_TIMER=7200

# Run without display (always 1 on the Pi/server)
HEADLESS_MODE=1

# Unbuffered Python output (logs appear immediately)
PYTHONUNBUFFERED=1
